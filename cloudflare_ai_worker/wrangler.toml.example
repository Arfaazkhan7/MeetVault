name = "meetvault-ai-worker"
main = "src/index.ts"
compatibility_date = "2026-10-21"
compatibility_flags = ["nodejs_compat"]

[[queues.producers]]
queue = "meetvault-ai-jobs"
binding = "AI_JOBS"

[[queues.consumers]]
queue = "meetvault-ai-jobs"
max_batch_size = 1
max_batch_timeout = 30

[ai]
binding = "AI"

[vars]
BACKEND_API_BASE_URL = "https://meetvault-api-candidate.aeris-cloud.workers.dev/api/v1"

# Set these with:
# npx wrangler secret put MEETVAULT_WORKER_SECRET
# npx wrangler secret put BACKEND_WORKER_CALLBACK_SECRET
# The free pipeline does not call external paid diarization services.

