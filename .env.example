DATABASE_URL=postgresql://user:password@localhost:5432/meetingdb
# Celery broker URL. Use a Redis protocol URL, not an Upstash REST URL/token snippet.
# Example for TLS Redis providers: rediss://default:password@host:6379/0
REDIS_URL=redis://localhost:6379/0
AI_WORKER_QUEUE=database
AI_WORKER_POLL_INTERVAL_SECONDS=5
AI_WORKER_STALE_JOB_MINUTES=30
AI_WORKER_LAMBDA_MAX_JOBS=1
AI_WORKER_LAMBDA_MAX_SECONDS=600
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=https://GOKUL5731.github.io
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET=your_s3_bucket
JWT_SECRET=your_jwt_secret
LIVEKIT_URL=wss://your-livekit-url
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret
LIVEKIT_TOKEN_EXPIRE_MINUTES=120
STORAGE_BACKEND=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=meeting-recordings
RECORDING_SIGNED_URL_EXPIRE_SECONDS=900
MAX_RECORDING_UPLOAD_BYTES=524288000
LLM_API_KEY=your_llm_api_key
EMBEDDING_MODEL=your_embedding_model

# ── AI Worker: Transcription ──────────────────────────────────────────────
# Provider: "huggingface" (default) uses whisper-large-v3 via HF Inference API
# Provider: "openai" uses OpenAI Whisper API (requires OPENAI_API_KEY)
TRANSCRIPTION_PROVIDER=huggingface
# Required for huggingface transcription provider
HF_TOKEN=your_hugging_face_access_token

# ── AI Worker: Speaker Diarization (pyannoteAI) ───────────────────────────
# IMPORTANT: pyannote/speaker-diarization-3.1 is NOT available on the generic
#            HF Serverless Inference API. HF_TOKEN alone does NOT enable diarization.
# Register at https://dashboard.pyannote.ai to get your API key (free trial available).
# Set this as a secret in Render dashboard → meetvault-ai-worker → Environment.
PYANNOTEAI_API_KEY=your_pyannoteai_api_key
# Override the diarization endpoint (default is fine for most users)
# PYANNOTEAI_API_URL=https://api.pyannote.ai/v1/diarize

# Flutter web build-time value. Browser safe; do not include secrets.
API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_PUBLIC_URL=http://localhost:3000

# Flutter Firebase Web build-time values. These are browser config values, not server secrets.
# FIREBASE_API_KEY is required for Google sign-in and must be copied from Firebase Console.
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=ai-meet-f8fd0.firebaseapp.com
FIREBASE_PROJECT_ID=ai-meet-f8fd0
FIREBASE_STORAGE_BUCKET=ai-meet-f8fd0.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=661020533786
FIREBASE_APP_ID=1:661020533786:web:ef4fd4bdd3c72a8e6c5da3
FIREBASE_MEASUREMENT_ID=G-C5KTB28SWG

# Backend Firebase verification. On Render, configure Firebase Admin credentials
# as a backend-only secret file or environment secret. Never commit it.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
