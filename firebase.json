{
  "hosting": {
    "public": "web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/login.html",
        "type": 302
      },
      {
        "source": "/login",
        "destination": "/login.html",
        "type": 302
      },
      {
        "source": "/signup",
        "destination": "/signup.html",
        "type": 302
      },
      {
        "source": "/admin",
        "destination": "/admin.html",
        "type": 302
      }
    ]
  }
}
